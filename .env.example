# Application configuration
APP_URL="http://localhost:3000"
DATABASE_URL="postgresql://user:password@localhost:5432/your-db-name?schema=public"
JWT_SECRET="change-this-to-a-long-random-secret"
ACCESS_TOKEN_EXPIRES_IN="3600"
REFRESH_TOKEN_EXPIRES_IN="2592000"
JOB_WORKER_POLL_INTERVAL_MS="2000"
JOB_WORKER_LOCK_TIMEOUT_MS="60000"
LOG_LEVEL="debug"
LOG_TO_CONSOLE="false"
USER_DOMAIN=""

# Google OAuth configuration
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# SMTP configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_ENCRYPTION="starttls"
SMTP_USER="smtp-user"
SMTP_PASSWORD="smtp-password"
SMTP_FROM="App <no-reply@example.com>"

# Storage configuration
STORAGE_DRIVER="local"
STORAGE_URL="http://localhost:3000/storage"
MINIO_ENDPOINT="http://localhost:9000"
MINIO_REGION="ap-southeast-1"
MINIO_BUCKET="App"
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_FORCE_PATH_STYLE="true"
S3_REGION="ap-southeast-1"
S3_BUCKET="App"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
