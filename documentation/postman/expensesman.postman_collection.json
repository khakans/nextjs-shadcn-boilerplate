    {
      "name": "Sessions",
      "item": [
        {
          "name": "List Active Sessions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const sessions = json.data && Array.isArray(json.data.sessions) ? json.data.sessions : [];",
                  "const otherSession = sessions.find((session) => !session.isCurrent);",
                  "if (otherSession) {",
                  "  pm.environment.set('session_id', otherSession.sessionId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mobile_access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/sessions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "sessions"
              ]
            },
            "description": "Lists active sessions for the current user. Saves the first non-current sessionId into `session_id` when available.\n\nCan be authenticated with web HttpOnly cookies or `Authorization: Bearer {{mobile_access_token}}` for mobile clients."
          }
        },
        {
          "name": "Revoke Session",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mobile_access_token}}"
              },
              {
                "key": "Origin",
                "value": "{{app_url}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/sessions/{{session_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "sessions",
                "{{session_id}}"
              ]
            },
            "description": "Revokes another active session. The current session cannot be revoked through this endpoint.\n\nCan be authenticated with web HttpOnly cookies or `Authorization: Bearer {{mobile_access_token}}` for mobile clients."
          }
        },
        {
          "name": "Logout Other Devices",
