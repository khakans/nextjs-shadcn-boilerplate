    {
      "name": "Mobile Auth",
      "description": "Token-based auth endpoints for mobile apps. These endpoints do not use browser cookies or CSRF origin checks. Store refresh tokens in secure device storage.",
      "item": [
        {
          "name": "Mobile Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300 && pm.response.text()) {",
                  "  const json = pm.response.json();",
                  "  const data = json.data || {};",
                  "  if (data.accessToken) pm.environment.set('mobile_access_token', data.accessToken);",
                  "  if (data.refreshToken) pm.environment.set('mobile_refresh_token', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/mobile/auth/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "mobile",
                "auth",
                "signup"
              ]
            },
            "description": "Creates a LOCAL user and returns accessToken plus refreshToken in the JSON response."
          }
        },
