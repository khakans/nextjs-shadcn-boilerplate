{
  "info": {
    "_postman_id": "9b4e7c6b-f857-48c1-9d49-f08d2e174c57",
    "name": "Expensesman API",
    "description": "Postman collection for Expensesman API. Responses use the envelope `{ status, message, data }`. Web authentication uses HttpOnly cookies, so keep Postman's cookie jar enabled. Mobile authentication returns bearer tokens in JSON.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response is valid JSON envelope when body exists', function () {",
          "  if (!pm.response.text()) return;",
          "  const json = pm.response.json();",
          "  pm.expect(json).to.have.property('status');",
          "  pm.expect(json).to.have.property('message');",
          "  pm.expect(json).to.have.property('data');",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "app_url",
      "value": "http://localhost:3000"
    }
  ],
