    {
      "name": "Audit Trails",
      "item": [
        {
          "name": "List Audit Trails",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const auditTrails = json.data && Array.isArray(json.data.auditTrails) ? json.data.auditTrails : [];",
                  "if (auditTrails[0]) {",
                  "  pm.environment.set('audit_trail_id', auditTrails[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mobile_access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/audit-trails?page=1&pageSize=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "audit-trails"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "5"
                }
              ]
            },
            "description": "Lists audit trail entries where the current user is actor or target. Saves the first audit trail id into `audit_trail_id` when available."
          }
        },
