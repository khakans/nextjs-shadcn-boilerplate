generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserSessionStatus {
  ONLINE
  LOGGED_OUT
  EXPIRED
  REVOKED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                  String               @id @default(uuid(7)) @db.Uuid
  name                String
  email               String               @unique
  username            String?              @unique
  passwordHash        String?
  provider            AuthProvider         @default(LOCAL)
  googleId            String?              @unique
  tokenVersion        Int                  @default(0)
  avatarUrl           String?
  birthDate           DateTime?
  birthPlace          String?
  gender              String?
  mobileNumber        String?
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  isActive            Boolean              @default(true)
  refreshTokens       RefreshToken[]
  userSessions        UserSession[]
  passwordResetTokens PasswordResetToken[]
  teamMembers         TeamMember[]
  actorAuditTrails    AuditTrail[]         @relation("AuditTrailActor")
  targetAuditTrails   AuditTrail[]         @relation("AuditTrailTarget")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model RefreshToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  userSessionId String?   @db.Uuid
  tokenHash     String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  replacedBy    String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userSession UserSession? @relation(fields: [userSessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userSessionId])
  @@index([expiresAt])
}

model UserSession {
  id              String            @id @default(uuid(7)) @db.Uuid
  userId          String            @db.Uuid
  sessionId       String            @unique
  browser         String?
  operatingSystem String?
  deviceName      String?
  ipAddress       String?
  userAgent       String?           @db.Text
  loginAt         DateTime          @default(now())
  lastActiveAt    DateTime          @default(now())
  logoutAt        DateTime?
  expiredAt       DateTime
  status          UserSessionStatus @default(ONLINE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([expiredAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Job {
  id          String    @id @default(uuid(7)) @db.Uuid
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  failedAt    DateTime?
  completedAt DateTime?
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([lockedAt])
  @@index([type])
}

model Company {
  id        String        @id @default(uuid(7)) @db.Uuid
  name      String
  email     String?
  phone     String?
  logo      String?       @db.Text
  address   String?       @db.Text
  timezone  String        @default("Asia/Jakarta")
  currency  String        @default("IDR")
  taxNumber String?       @map("tax_number")
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([name])
  @@map("companies")
}

model Team {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  code        String       @unique
  description String?      @db.Text
  status      String       @default("active")
  members     TeamMember[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([name])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid(7)) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  isPrimary Boolean  @default(true) @map("is_primary")
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([role])
  @@index([isPrimary])
  @@map("team_members")
}

model AuditTrail {
  id            String   @id @default(uuid(7)) @db.Uuid
  actorUserId   String?  @db.Uuid
  targetUserId  String?  @db.Uuid
  userSessionId String?  @db.Uuid
  action        String
  entityType    String
  entityId      String?
  status        String
  before        Json?
  after         Json?
  changedFields String[] @default([])
  metadata      Json?
  ipAddress     String?
  userAgent     String?  @db.Text
  requestId     String?
  createdAt     DateTime @default(now())

  actorUser  User? @relation("AuditTrailActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditTrailTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([status, createdAt])
  @@index([createdAt])
}
